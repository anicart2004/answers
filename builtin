
-- NUMBER FUNCTIONS
SELECT ABS(-15) AS ABS_VALUE FROM dual;
SELECT CEIL(12.3) AS CEIL_VALUE FROM dual;
SELECT FLOOR(12.9) AS FLOOR_VALUE FROM dual;
SELECT ROUND(12.345, 2) AS ROUND_VALUE FROM dual;
SELECT TRUNC(12.987, 2) AS TRUNC_VALUE FROM dual;
SELECT MOD(10, 3) AS REMAINDER FROM dual;
SELECT POWER(2, 3) AS POWER_VALUE FROM dual;
SELECT SQRT(25) AS SQUARE_ROOT FROM dual;

-- DATE FUNCTIONS
SELECT SYSDATE AS TODAY_DATE FROM dual;
SELECT ADD_MONTHS(SYSDATE, 2) AS AFTER_2_MONTHS FROM dual;
SELECT MONTHS_BETWEEN(SYSDATE, '01-JAN-25') AS MONTH_DIFF FROM dual;
SELECT NEXT_DAY(SYSDATE, 'FRIDAY') AS NEXT_FRIDAY FROM dual;
SELECT LAST_DAY(SYSDATE) AS MONTH_END FROM dual;


🔢 COUNT FUNCTION (with table)
-- CREATE TABLE
CREATE TABLE STUDENT (
    ID NUMBER,
    NAME VARCHAR(20),
    MARK NUMBER
);

-- INSERT VALUES
INSERT INTO STUDENT VALUES (1, 'Alwin', 90);
INSERT INTO STUDENT VALUES (2, 'Ayanokoji', NULL);
INSERT INTO STUDENT VALUES (3, 'Kiyotaka', 85);
INSERT INTO STUDENT VALUES (4, 'Riku', 90);
INSERT INTO STUDENT VALUES (5, 'Senku', 70);

-- COUNT QUERIES
SELECT COUNT(*) AS TOTAL_ROWS FROM STUDENT;
SELECT COUNT(MARK) AS NON_NULL_MARKS FROM STUDENT;
SELECT COUNT(DISTINCT MARK) AS UNIQUE_MARKS FROM STUDENT;
SELECT COUNT(NAME) AS NAME_COUNT FROM STUDENT;
SELECT COUNT(*) AS MARK_ABOVE_80 FROM STUDENT WHERE MARK > 80;

-- CHARACTER FUNCTIONS
SELECT UPPER('alwin') AS UPPERCASE FROM dual;
SELECT LOWER('AYANOKOJI') AS LOWERCASE FROM dual;
SELECT INITCAP('alwin ayanokoji') AS INITCAP_NAME FROM dual;
vSELECT LENGTH('Ayanokoji') AS NAME_LENGTH FROM dual;
SELECT SUBSTR('Ayanokoji', 2, 4) AS SUB_STRING FROM dual;
SELECT INSTR('Ayanokoji', 'ko') AS POSITION FROM dual;
SELECT CONCAT('Alwin', ' Ayanokoji') AS FULLNAME FROM dual;
SELECT REPLACE('SQL Rocks', 'Rocks', 'Rules') AS NEW_TEXT FROM dual;

