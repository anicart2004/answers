(iv) Find the total number of people who owned cars that were involved in accidents in 2022
SELECT COUNT(DISTINCT O.DRIVER_IDNO) AS TOTAL_OWNERS
FROM OWNS O
JOIN PARTICIPATED P ON O.REGNO = P.REGNO
JOIN ACCIDENT A ON P.REPORT_NO = A.REPORT_NO
WHERE EXTRACT(YEAR FROM A.ADATE) = 2022;

(v) Find the number of accidents in which cars of a specific model were involved.
SELECT C.MODEL, COUNT(DISTINCT A.REPORT_NO) AS TOTAL_ACCIDENTS
FROM CAR C
JOIN PARTICIPATED P ON C.REGNO = P.REGNO
JOIN ACCIDENT A ON P.REPORT_NO = A.REPORT_NO
WHERE C.MODEL = 'Swift'
GROUP BY C.MODEL;
